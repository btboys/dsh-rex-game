{
  "name": "dsh-whale-break",
  "version": "0.3.0",
  "type": "module",
  "description": "A DeepSeek whale mini-game for DeepSeek Harness with a shared scoreboard: it pops up while a turn is running and hides when the turn finishes or waits for you.",
  "author": "夏悸",
  "license": "MIT",
  "homepage": "https://github.com/btboys/dsh-rex-game#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btboys/dsh-rex-game.git"
  },
  "bugs": {
    "url": "https://github.com/btboys/dsh-rex-game/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "scoreboard.js",
    "server"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "game",
    "mini-game",
    "whale",
    "dino"
  ],
  "scripts": {
    "test": "node test/selfcheck.mjs && node test/scoreboard.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
